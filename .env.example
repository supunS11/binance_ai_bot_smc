# =========================
# EXCHANGE / ACCOUNT
# =========================
API_KEY=
SECRET_KEY=
# True = talk to Binance Futures Testnet (testnet.binancefuture.com) for
# everything - REST and websockets. Use a separate key pair generated at
# https://testnet.binancefuture.com, not your real account's keys.
BINANCE_TESTNET=True

# =========================
# RATE LIMITING
# =========================
BINANCE_PUBLIC_WEIGHT_LIMIT_PER_MINUTE=1800
BINANCE_PUBLIC_RATE_WINDOW_SECONDS=60
KLINE_REQUEST_WEIGHT=2
EXCHANGE_INFO_REQUEST_WEIGHT=1
BINANCE_MIN_REQUEST_GAP_SECONDS=0.05

# =========================
# SYMBOL UNIVERSE / WATCHLIST
# =========================
# Comma-separated to pin an exact symbol list, e.g. BTCUSDT,ETHUSDT.
# Leave blank to auto-select the top WATCHLIST_SIZE symbols by 24h volume -
# recommended over pinning a large list, which can silently include
# illiquid/vanity-listed pairs that hurt structure/order-flow signal
# quality (evidence: 2026-08-11).
SCAN_SYMBOLS=
QUOTE_ASSET=USDT
WATCHLIST_SIZE=400
WATCHLIST_REFRESH_SECONDS=300
VOLUME_POLL_INTERVAL_SECONDS=300
# Signal-time liquidity floor (24h quote volume, USDT). 0 disables it.
# Independent of WATCHLIST_SIZE/SCAN_SYMBOLS - useful if SCAN_SYMBOLS is
# pinned to a broad/unfiltered universe and you still want illiquid
# symbols excluded from actually trading, not just from being watched.
MIN_24H_QUOTE_VOLUME_USDT=1500000

# =========================
# WEBSOCKET DATA LAYER
# =========================
WS_ENABLED=True
# LTF structure-trigger timeframe. Moved from 15m -> 1h (2026-08-11):
# standard ICT/SMC practice favors this pairing with a 4h HTF bias over
# very low timeframes, which are noisier and more prone to false breaks.
WS_KLINE_INTERVAL=1h
WS_KLINE_HISTORY_LIMIT=200
HTF_KLINE_INTERVAL=4h
HTF_KLINE_HISTORY_LIMIT=200
WS_STREAMS_PER_SOCKET=100
WS_DEPTH_STREAMS_PER_SOCKET=50
WS_DEPTH_LEVELS=20
WS_DEPTH_SPEED_MS=100ms
WS_STALE_SECONDS=45
WS_WATCHDOG_INTERVAL_SECONDS=15
WS_RESTART_COOLDOWN_SECONDS=30

# =========================
# ORDER FLOW (CVD)
# =========================
ORDER_FLOW_MAX_WINDOW_SECONDS=900
ORDER_FLOW_MIN_NOTIONAL_USDT=5000
ORDER_FLOW_DIVERGENCE_LOOKBACK=20
CVD_HISTORY_MAXLEN=200

# =========================
# MARKET STRUCTURE (ICT/SMC)
# =========================
SWING_LEFT=4
SWING_RIGHT=4
STRUCTURE_LOOKBACK_CANDLES=150
FVG_LOOKBACK_CANDLES=50
LIQUIDITY_POOL_TOLERANCE_PCT=0.001
PREMIUM_DISCOUNT_LOOKBACK_CANDLES=100
# Deeper than the classic 0.618 - see config.py comment above this setting.
OTE_RETRACEMENT_MIN=0.705
OTE_RETRACEMENT_MAX=0.79
ATR_PERIOD=14
# Chop/trend regime (Kaufman's Efficiency Ratio) and BTC correlation -
# both informational only, never gated.
CHOP_FILTER_LOOKBACK_CANDLES=14
BTC_CORRELATION_ENABLED=True
CORRELATION_LOOKBACK_CANDLES=20
CORRELATION_REFERENCE_SYMBOL=BTCUSDT
# HTF bias freshness check - a faster-updating EMA-based read alongside
# the swing-confirmed htf_trend, since a swing can take 16+ real hours to
# confirm on the 4h HTF, letting a stale bias persist well after real
# price has already moved against it. See config.py comment above these
# settings for the full rationale and real evidence (CATIUSDT).
HTF_TREND_FRESHNESS_ENABLED=True
HTF_TREND_EMA_PERIOD=20

# =========================
# SIGNAL ENGINE - order-flow confirmation thresholds
# =========================
SIGNAL_MIN_CVD_SCORE=0.15
SIGNAL_MIN_DEPTH_IMBALANCE=0.10
REQUIRE_ORDER_BLOCK_OR_FVG=True
EMA_CONFIRMATION_ENABLED=True
EMA_CONFIRMATION_PERIOD=20
OI_CONFIRMATION_ENABLED=True
OI_POLL_INTERVAL_SECONDS=60
OI_LOOKBACK_SECONDS=900
# Raised from 60 -> 1440 - see config.py comment above this setting
# (backs OI_DIVERGENCE_TRIGGER_ENABLED below, which needs much more
# history than the recent-window oi_change_pct snapshot alone did).
OI_HISTORY_MAX_SAMPLES=1440
OI_UNAVAILABLE_SYMBOL_COOLDOWN_SECONDS=3600
LIQUIDATION_CONFIRMATION_ENABLED=True
LIQUIDATION_WINDOW_SECONDS=120
LIQUIDATION_CLUSTER_MIN_NOTIONAL_USDT=50000
LIQUIDATION_MAX_EVENTS_PER_SYMBOL=200
# Funding rate - free (reuses the mark-price endpoint), polled in bulk.
FUNDING_RATE_ENABLED=True
FUNDING_POLL_INTERVAL_SECONDS=300
# Long/short account ratio - fetched on-demand (no bulk endpoint exists),
# only for a candidate that's already passed every other check.
LONG_SHORT_RATIO_ENABLED=True
# Boolean "favorable" readings derived from the three fields above -
# informational only, journaled but NOT fed into confluence sizing (that
# mechanism is disabled on real negative evidence - see
# CONFLUENCE_SIZING_ENABLED below). Not gates either, same evidence-first
# treatment as every other informational field here.
EFFICIENCY_RATIO_CHOP_THRESHOLD=0.3
FUNDING_RATE_ADVERSE_THRESHOLD=0.0005
LONG_SHORT_RATIO_CROWD_THRESHOLD=2.0
# Require the triggering LTF candle to actually CLOSE beyond the structure
# level before entering, instead of reacting to a still-forming candle's
# wick. Costs up to one candle of entry latency. Evidence: 2026-08-11
# journal_analysis.py batch, see config.py comment above this setting.
REQUIRE_CLOSE_CONFIRMED_BREAK=True
# Second, alternative entry trigger - a detected liquidity sweep. See
# config.py comment above this setting for the full rationale.
LIQUIDITY_SWEEP_TRIGGER_ENABLED=False
# Third entry trigger - an already-confirmed CHoCH reversal, retested.
# Fourth entry trigger - a fresh rejection wick into an unmitigated FVG.
# See config.py comments above these settings for the full rationale and
# known tradeoffs.
CHOCH_RETEST_TRIGGER_ENABLED=False
CHOCH_TRIGGER_MAX_AGE_CANDLES=10
OB_FVG_RETEST_TRIGGER_ENABLED=False
OB_FVG_RETEST_MAX_AGE_CANDLES=20
# Extra confirm-ticks required for any trigger except STRUCTURE_BREAK, plus
# a smaller bump for STRUCTURE_BREAK itself - see config.py comments above
# these settings.
EXTRA_CONFIRM_TICKS_FOR_NEW_TRIGGERS=1
STRUCTURE_BREAK_EXTRA_CONFIRM_TICKS=0
# Rank qualifying triggers by objective quality (distance from current
# price to the trigger level) instead of the fixed priority order - see
# config.py comments above these settings for the full rationale and the
# hysteresis margin that prevents tick-to-tick flapping.
TRIGGER_QUALITY_RANKING_ENABLED=False
TRIGGER_QUALITY_EDGE_ATR_MULTIPLE=0.25
# Fifth entry trigger - price's swing structure vs the CVD line at those
# same swing points (classic order-flow divergence/absorption). See
# config.py comments above these settings for the full rationale.
CVD_DIVERGENCE_TRIGGER_ENABLED=False
CVD_DIVERGENCE_MIN_DELTA_USDT=5000
# Sixth entry trigger - a fresh rejection wick back into a previously-
# formed, unmitigated order block (the order-block counterpart to
# OB_FVG_RETEST above). See config.py comments above these settings.
ORDER_BLOCK_RETEST_TRIGGER_ENABLED=False
ORDER_BLOCK_RETEST_MAX_AGE_CANDLES=20
ORDER_BLOCK_RETEST_LOOKBACK_EVENTS=5
# Seventh entry trigger - price's swing structure vs open interest at
# those same swing points. See config.py comments above these settings.
OI_DIVERGENCE_TRIGGER_ENABLED=False
OI_DIVERGENCE_MIN_DELTA_PCT=5.0
OI_DIVERGENCE_TRIGGER_MAX_AGE_CANDLES=20
# Eighth entry trigger - a plain LIQUIDITY_SWEEP additionally confirmed
# by a real clustered forced-liquidation event. See config.py comments
# above this setting.
LIQUIDATION_SWEEP_CONFIRMED_TRIGGER_ENABLED=False
# Ninth entry trigger - a pullback to the EMA followed by a same-candle
# reclaim, well suited to smooth-trending majors that rarely satisfy the
# other triggers' deep-retracement/order-flow-imbalance gates. See
# config.py comments above this setting for the full rationale.
EMA_PULLBACK_TRIGGER_ENABLED=False

# =========================
# RISK MANAGEMENT
# =========================
MARGIN_PER_TRADE=10
LEVERAGE=10
MARGIN_TYPE=ISOLATED
RISK_BASED_POSITION_SIZING_ENABLED=True
POSITION_RISK_PCT=1.0
POSITION_RISK_MAX_USDT=0
STRUCTURE_STOP_ATR_BUFFER=0.5
MIN_STOP_DISTANCE_PCT=0.6
# Second stop floor, in ATR multiples - whichever floor is wider wins. See
# config.py comment above this setting for the full rationale.
MIN_STOP_DISTANCE_ATR_MULTIPLE=1.0
# Rejects an entry that's already run more than this many R beyond the
# structure level that triggered it - i.e. chasing an already-extended
# move instead of catching it near the level that made the setup valid.
# 0 disables it.
MAX_ENTRY_EXTENSION_R=0.5
# Rejects an entry whose stop, at LEVERAGE, would lose more than this % of
# margin if hit - see config.py comment above this setting for the full
# rationale.
MAX_SL_ROI_PCT=30
CONFLUENCE_SIZING_ENABLED=False
CONFLUENCE_SIZING_MIN_MULTIPLIER=0.5
CONFLUENCE_SIZING_MAX_MULTIPLIER=1.25
SYMBOL_REENTRY_COOLDOWN_SECONDS=3600
MAX_TOTAL_POSITIONS=2

# =========================
# TP1 / TP2
# =========================
TP1_CLOSE_PCT=50
TP1_R_MULTIPLE=2.0
TP2_R_MULTIPLE=4.0
TP1_MAX_R_MULTIPLE=6.0
TP2_MAX_R_MULTIPLE=10.0
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=True
BREAKEVEN_BUFFER_PCT=0.02
EARLY_BREAKEVEN_ENABLED=True
EARLY_BREAKEVEN_R_MULTIPLE=0.5
# Replaces the fixed EARLY_BREAKEVEN_LOCK_R_MULTIPLE distance with the
# most recent CONFIRMED market-structure swing point in the trade's
# favor, clamped to never sit worse than flat breakeven - and trails the
# stop the same way for the whole BREAKEVEN_ACTIVE phase (ratchet-only,
# TP2 unchanged). Weaker but real guarantee than the fixed lock: "never
# worse than breakeven" instead of "at least EARLY_BREAKEVEN_LOCK_R_MULTIPLE
# locked". NOT proven more profitable yet. SWING_LEFT/SWING_RIGHT=4 means
# a swing needs ~4 confirming 1h candles, so this often falls back to
# plain breakeven behavior on shorter trades. Default OFF.
EARLY_BREAKEVEN_LOCK_R_MULTIPLE=0.3
# A second, independent early-promotion mechanism measured in % of TP1's
# own ROI instead of an R-multiple - see config.py comments above these
# settings for the full rationale.
PROFIT_PROTECTION_ENABLED=False
PROFIT_PROTECTION_ACTIVATION_PCT_OF_TP1=60
PROFIT_PROTECTION_LOCK_PCT_OF_TP1=25
PROFIT_PROTECTION_RETRACE_PCT=50
STRUCTURE_STOP_MANAGEMENT_ENABLED=False
MAE_TRACKING_ENABLED=True

# =========================
# EXECUTION
# =========================
# SHADOW: evaluate + size + journal signals, place no real orders.
# LIVE: actually place entry + SL/TP1/TP2. Keep this on SHADOW until
# shadow signal quality has been reviewed - it does not default to LIVE.
EXECUTION_MODE=SHADOW
POSITION_POLL_INTERVAL_SECONDS=10
SIGNAL_EVAL_INTERVAL_SECONDS=3
# A signal must qualify for this many consecutive eval ticks in a row
# before it's acted on, instead of the first instant it appears - filters
# out CVD/depth-imbalance noise that flickers pass/fail within seconds.
# 1 disables it (original behavior).
SIGNAL_CONFIRM_TICKS=3
SHADOW_ACCOUNT_BALANCE_USDT=1000
# Enables per-signal market-vs-limit ROUTING, not "always place a limit
# order" - a signal within ENTRY_ROUTING_EXTENSION_THRESHOLD_R of the
# structure level still gets a market order (guaranteed fill, chase cost
# is minimal); only a signal that's already moderately extended (above
# the threshold but under the hard MAX_ENTRY_EXTENSION_R reject) gets
# routed to a resting GTC LIMIT at entry_price instead - fills at/better
# than the real level, or is walked away from, never chased further.
# NO market-order fallback on a limit's expiry/invalidation - that's the
# entire point of routing those entries away from market. Default OFF.
LIMIT_ENTRY_MODE_ENABLED=False
# Must be less than MAX_ENTRY_EXTENSION_R for the "route to limit" band
# to be non-empty. Starting value, not calibrated.
ENTRY_ROUTING_EXTENSION_THRESHOLD_R=0.2
# Wall-clock, decoupled from SIGNAL_EVAL_INTERVAL_SECONDS on purpose.
# 600s chosen against WS_KLINE_INTERVAL=1h/HTF_KLINE_INTERVAL=4h -
# roughly 1/6 of the triggering candle. Starting value, not calibrated.
LIMIT_ENTRY_EXPIRY_SECONDS=600

# =========================
# LOGGING / ALERTING
# =========================
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
