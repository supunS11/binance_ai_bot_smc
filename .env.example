# =========================
# EXCHANGE / ACCOUNT
# =========================
API_KEY=
SECRET_KEY=
# True = talk to Binance Futures Testnet (testnet.binancefuture.com) for
# everything - REST and websockets. Use a separate key pair generated at
# https://testnet.binancefuture.com, not your real account's keys.
BINANCE_TESTNET=True

# =========================
# RATE LIMITING
# =========================
BINANCE_PUBLIC_WEIGHT_LIMIT_PER_MINUTE=1800
BINANCE_PUBLIC_RATE_WINDOW_SECONDS=60
KLINE_REQUEST_WEIGHT=2
EXCHANGE_INFO_REQUEST_WEIGHT=1

# =========================
# SYMBOL UNIVERSE / WATCHLIST
# =========================
# Comma-separated to pin an exact symbol list, e.g. BTCUSDT,ETHUSDT.
# Leave blank to auto-select the top WATCHLIST_SIZE symbols by 24h volume.
SCAN_SYMBOLS=
QUOTE_ASSET=USDT
WATCHLIST_SIZE=15
WATCHLIST_REFRESH_SECONDS=300

# =========================
# WEBSOCKET DATA LAYER
# =========================
WS_ENABLED=True
WS_KLINE_INTERVAL=15m
WS_KLINE_HISTORY_LIMIT=200
HTF_KLINE_INTERVAL=1h
HTF_KLINE_HISTORY_LIMIT=200
WS_STREAMS_PER_SOCKET=100
WS_DEPTH_STREAMS_PER_SOCKET=50
WS_DEPTH_LEVELS=20
WS_DEPTH_SPEED_MS=100ms
WS_STALE_SECONDS=45
WS_WATCHDOG_INTERVAL_SECONDS=15
WS_RESTART_COOLDOWN_SECONDS=30

# =========================
# ORDER FLOW (CVD)
# =========================
ORDER_FLOW_MAX_WINDOW_SECONDS=900
ORDER_FLOW_MIN_NOTIONAL_USDT=5000
ORDER_FLOW_DIVERGENCE_LOOKBACK=20

# =========================
# MARKET STRUCTURE (ICT/SMC)
# =========================
SWING_LEFT=4
SWING_RIGHT=4
STRUCTURE_LOOKBACK_CANDLES=150
FVG_LOOKBACK_CANDLES=50
LIQUIDITY_POOL_TOLERANCE_PCT=0.001
PREMIUM_DISCOUNT_LOOKBACK_CANDLES=100
OTE_RETRACEMENT_MIN=0.618
OTE_RETRACEMENT_MAX=0.79
ATR_PERIOD=14

# =========================
# SIGNAL ENGINE - order-flow confirmation thresholds
# =========================
SIGNAL_MIN_CVD_SCORE=0.15
SIGNAL_MIN_DEPTH_IMBALANCE=0.10
REQUIRE_ORDER_BLOCK_OR_FVG=True
EMA_CONFIRMATION_ENABLED=True
EMA_CONFIRMATION_PERIOD=20
OI_CONFIRMATION_ENABLED=True
OI_POLL_INTERVAL_SECONDS=60
OI_LOOKBACK_SECONDS=900
OI_HISTORY_MAX_SAMPLES=60
OI_UNAVAILABLE_SYMBOL_COOLDOWN_SECONDS=3600
LIQUIDATION_CONFIRMATION_ENABLED=True
LIQUIDATION_WINDOW_SECONDS=120
LIQUIDATION_CLUSTER_MIN_NOTIONAL_USDT=50000
LIQUIDATION_MAX_EVENTS_PER_SYMBOL=200

# =========================
# RISK MANAGEMENT
# =========================
MARGIN_PER_TRADE=10
LEVERAGE=10
MARGIN_TYPE=ISOLATED
RISK_BASED_POSITION_SIZING_ENABLED=True
POSITION_RISK_PCT=1.0
POSITION_RISK_MAX_USDT=0
STRUCTURE_STOP_ATR_BUFFER=0.5
MIN_STOP_DISTANCE_PCT=0.6
CONFLUENCE_SIZING_ENABLED=False
CONFLUENCE_SIZING_MIN_MULTIPLIER=0.5
CONFLUENCE_SIZING_MAX_MULTIPLIER=1.25
SYMBOL_REENTRY_COOLDOWN_SECONDS=900
MAX_TOTAL_POSITIONS=2

# =========================
# TP1 / TP2
# =========================
TP1_CLOSE_PCT=50
TP1_R_MULTIPLE=2.0
TP2_R_MULTIPLE=4.0
TP1_MAX_R_MULTIPLE=6.0
TP2_MAX_R_MULTIPLE=10.0
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=True
BREAKEVEN_BUFFER_PCT=0.02
EARLY_BREAKEVEN_ENABLED=True
EARLY_BREAKEVEN_R_MULTIPLE=1.0
MAE_TRACKING_ENABLED=True

# =========================
# EXECUTION
# =========================
# SHADOW: evaluate + size + journal signals, place no real orders.
# LIVE: actually place entry + SL/TP1/TP2. Keep this on SHADOW until
# shadow signal quality has been reviewed - it does not default to LIVE.
EXECUTION_MODE=SHADOW
POSITION_POLL_INTERVAL_SECONDS=10
SIGNAL_EVAL_INTERVAL_SECONDS=5
SHADOW_ACCOUNT_BALANCE_USDT=1000

# =========================
# LOGGING / ALERTING
# =========================
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
